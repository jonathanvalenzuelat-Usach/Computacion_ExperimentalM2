FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/python/matmul.py .
COPY docker/run_container.sh .
RUN sed -i 's/\r$//' run_container.sh && chmod +x run_container.sh
ENV LANG_ID=python RUN_CMD="python3 /app/matmul.py" VERSION_CMD="python3 --version"
ENTRYPOINT ["/app/run_container.sh"]